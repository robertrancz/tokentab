Screen {
    background: #111318;
    color: #e8e6e3;
}

Header {
    background: #1c212b;
}

Footer {
    background: #1c212b;
}

.status {
    padding: 0 1 0 1;
    color: #9aa3b2;
    background: #161a22;
}

.kpi-row {
    height: auto;
    padding: 1;
}

.kpi {
    width: 1fr;
    padding: 1;
    margin-right: 1;
    background: #1c212b;
    border: tall #2c3340;
}

#spark, #sources-bars, #tokens-line, #basis-line, #forecast-body {
    padding: 0 1 1 1;
}

.muted {
    color: #9aa3b2;
    padding: 0 1 1 1;
}

.form-row, .key-row {
    height: auto;
    padding: 0 1 1 1;
}

Input, Select, Button {
    margin-right: 1;
}

DataTable {
    height: 1fr;
    padding: 0 1 1 1;
}

.section-title {
    padding: 1;
    text-style: bold;
}

TabbedContent {
    height: 1fr;
}

Checkbox {
    padding: 0 1 0 1;
}
